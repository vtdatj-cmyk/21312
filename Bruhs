local function playAnnounceSound(soundName)
    pcall(function()
        local Assets = ReplicatedStorage:FindFirstChild("Assets")
        local Sounds = Assets and Assets:FindFirstChild("Sounds")
        local BossEventSounds = Sounds and Sounds:FindFirstChild("BossEventSounds")
        local soundObj = BossEventSounds and BossEventSounds:FindFirstChild(soundName)
        
        if soundObj and soundObj:IsA("Sound") then
            local soundClone = soundObj:Clone()
            soundClone.Volume = 0.7
            soundClone.PlaybackSpeed = 1.15
            soundClone.Parent = SoundService
            
            local played = false
            local Audio = nil
            pcall(function()
                Audio = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Audio"))
            end)

            if Audio and type(Audio.Play) == "function" then
                local ok = pcall(function()
                    Audio.Play(soundClone, SoundService, { Volume = 0.7, PlaybackSpeed = 1.15 })
                end)
                if ok then played = true end
            end
            
            if not played then soundClone:Play() end
            
            task.delay(soundClone.TimeLength > 0 and soundClone.TimeLength or 3, function()
                if soundClone and soundClone.Parent then soundClone:Destroy() end
            end)
        end
    end)
end

-- Hàm thực thi việc hiển thị thông báo thực tế cho người chơi nhận được
local function showNotificationForPlayer(senderPlayer, customText, selectedNotif, selectedSound)
    local DISPLAY_SECONDS = 3 

    local success, err = pcall(function()
        local Lanes = require(ReplicatedStorage:WaitForChild("Client"):WaitForChild("Notifications"):WaitForChild("Lanes"))
        local notifsFolder = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("UI"):WaitForChild("Notifs")
        local templateNotif = notifsFolder:WaitForChild(selectedNotif)

        local clonedFrame = templateNotif:Clone()

        local avatarUrl = ""
        pcall(function()
            avatarUrl = Players:GetUserThumbnailAsync(
                senderPlayer.UserId, 
                Enum.ThumbnailType.HeadShot, 
                Enum.ThumbnailSize.Size420x420
            )
        end)

        for _, obj in ipairs(clonedFrame:GetDescendants()) do
            if obj:IsA("TextLabel") then
                if config.TextEnabled then
                    if obj.Name == "Body" or obj.Name == "Title" or obj.Text ~= "" then
                        obj.Text = customText
                        obj.Visible = true
                        obj.TextTransparency = 0
                    end
                else
                    obj.Text = ""
                    obj.Visible = false
                    obj.TextTransparency = 1
                end
            end
        end

        local plate = clonedFrame:FindFirstChild("Plate") or clonedFrame:FindFirstChild("CorruptedPlate")
        if plate then
            local iconObj = plate:FindFirstChild("Icon")
            if iconObj then
                iconObj.Visible = true
                if iconObj:IsA("ImageLabel") or iconObj:IsA("ImageButton") then
                    iconObj.Image = avatarUrl
                end
                for _, childImg in ipairs(iconObj:GetDescendants()) do
                    if childImg:IsA("ImageLabel") or childImg:IsA("ImageButton") then
                        childImg.Image = avatarUrl
                        childImg.Visible = true
                    end
                end
            end
        end

        Lanes.Schedule({
            Lane = "Banner",
            Seconds = DISPLAY_SECONDS,
            UniqueKey = selectedNotif .. "_" .. tick(),
            Frame = clonedFrame,
            OnShown = function()
                playAnnounceSound(selectedSound)
            end
        })
    end)

    if not success then
        warn("Lỗi khi hiển thị thông báo:", err)
    end
end

-- Lắng nghe tín hiệu từ những người chơi khác gửi tới
if syncEvent then
    syncEvent.OnClientEvent:Connect(function(sender, text, notifSkin, soundName)
        if sender and sender ~= localPlayer then
            showNotificationForPlayer(sender, text, notifSkin, soundName)
        end
    end)
end

